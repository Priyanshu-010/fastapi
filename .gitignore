# =============================================================================
# FastAPI / Python .gitignore
# =============================================================================

# --- SECURITY & SENSITIVE DATA (Critical) ---
# Never commit secrets, keys, or local configuration files
.env
.env.local
.env.*.local
*.key
*.pem
*.secret
secrets.json
credentials.json

# --- VIRTUAL ENVIRONMENTS ---
# Prevents committing large dependency directories
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pypackages__/

# --- PYTHON ARTIFACTS ---
# Byte-compiled, optimized, and DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- BUILD & DISTRIBUTION ---
# Files created during packaging or installation
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec

# --- TESTING & COVERAGE ---
# Cache and reports generated by test runners
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
nosetests.xml

# --- TYPE CHECKERS & LINTERS ---
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# --- IDE & EDITOR CONFIGURATIONS ---
# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history

# Vim / Emacs
*~
.*.sw?
*.swo
*#

# --- DATABASES & LOGS ---
# SQLite databases and journal files
*.sqlite3
*.sqlite3-journal
db.sqlite3
test.db

# Application logs
*.log
log.txt

# --- OPERATING SYSTEM ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.Trash-*
.fuse_hidden*

# --- FASTAPI SPECIFIC / DEPLOYMENT ---
# Optional: Ignore serverless or specific build folders if not needed in repo
.serverless/
.netlify/
.vercel/

# Jupyter Notebooks (if used for experimentation)
.ipynb_checkpoints   